# Copy this file to deploy.env and fill in your own values.
# deploy.env is gitignored -- your key path and host will never be committed.

# Path to the SSH private key for your cloud VM (any provider: AWS EC2, GCP, DigitalOcean, ...)
SSH_KEY_PATH=~/.ssh/your-key.pem

# SSH user for the VM (e.g. ec2-user, ubuntu, root -- depends on the AMI/image)
REMOTE_USER=ec2-user

# Public IP or hostname of the VM
REMOTE_HOST=your-instance-public-ip-or-hostname

# SSH port, if not the default
REMOTE_PORT=22

# Where to place the code on the remote host
REMOTE_DIR=~/distributed-book-store-src
